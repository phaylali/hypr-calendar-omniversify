  color: @theme_fg_color;
}
.title-sub {
  font-size: 12px;
  font-weight: 500;
  color: @theme_selected_bg_color;
  font-family: "Noto Sans Tifinagh", "Noto Sans", sans-serif;
}
/* The year in the title is the entry point to the year picker. */
.title-year {
  background-color: transparent;
  color: @theme_selected_bg_color;
