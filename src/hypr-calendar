#!/usr/bin/python3
"""hypr-calendar - a multi-calendar overlay for Hyprland.

Replaces lvsk-calendar in the waybar clock overlay. Three calendar systems
(Gregorian, Hijri/Umm al-Qura, Amazigh/Julian), no bottom help bar, no
theme switcher of its own.

Theming follows the system GTK theme. GTK loads the theme's gtk.css at THEME
priority (200) and ~/.config/gtk-4.0/gtk.css at USER priority (800), so the
theme in settings.ini wins; this file only lays out the widget and binds a
handful of semantic colours (@theme_selected_bg_color, @borders) that every
reasonable theme defines. Per-machine tweaks go in
~/.config/hypr-calendar/style.css, which is loaded last.

Unlike the earlier layer-shell attempt, this is a normal XDG toplevel, so it
takes keyboard focus, is draggable by its header bar, and leaves the tiled
windows behind it fully interactive - the same behaviour the kitty-wrapped
lvsk-calendar had, which is what we wanted all along.

All calendar math is vendored in data.json (see DATA_PATH: ~/.local/share
first, then /usr/share/hypr-calendar/) and was validated against
morocco-date-api (Amazigh) and Aladhan (Hijri) before use.
"""
import datetime
import json
import os
import sys

os.environ.setdefault("GDK_BACKEND", "wayland")

import gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk, Gdk, GLib

HOME = os.path.expanduser("~")
CONFIG_DIR = os.path.join(HOME, ".config/hypr-calendar")
CONFIG_PATH = os.path.join(CONFIG_DIR, "config")

# The tables live in $XDG_DATA_HOME first (manual install, or anything the
# user regenerated) and fall back to the system copy the AUR package ships.
# A package must never write into $HOME, so /usr/share is the canonical
# location once installed and the local file only ever overrides it.
_DATA_CANDIDATES = (
    os.path.join(HOME, ".local/share/hypr-calendar/data.json"),
    "/usr/share/hypr-calendar/data.json",
)
DATA_PATH = next((p for p in _DATA_CANDIDATES if os.path.exists(p)),
                 _DATA_CANDIDATES[0])

DATA = json.load(open(DATA_PATH))
MONTHS = DATA["months"]
MONTH_STARTS = DATA["month_starts"]
HIJRI_OFFSET = DATA["hijri_offset"]

# active-calendar key -> (months table key, period tag)
# Tags are script-appropriate: Latin G for Gregorian, Arabic هـ (heh +
# tatweel, the usual Hijri abbreviation) for Hijri, Tifinagh ⵣ for Amazigh.
CALS = {
    "gregorian": ("gregorian", "G"),
    "hijri": ("islamic", "هـ"),
    "amazigh": ("amazigh", "ⵣ"),
}
CAL_ORDER = ["gregorian", "hijri", "amazigh"]
# switcher label + the font that actually has glyphs for it
CAL_LABEL = {
    "gregorian": ("Gregorian", ""),
    "hijri": ("هجري", "lang-ar"),
    "amazigh": ("ⵉⵎⴰⵣⵉⴳⵏ", "lang-tfng"),
}
# Bidi note: the widget never builds a mixed-script string. An Arabic tag
# inside one text run makes Pango flip the whole paragraph to RTL and print
# "28 ه"; verified by rendering. Every tag and every number is therefore its
# own Gtk.Label (see _pair_box), so the runs never meet.
WEEKDAYS = ["mo", "tu", "we", "th", "fr", "sa", "su"]


# --------------------------------------------------------------------------
# Calendar math (validated in gen_data.py against morocco-date-api + Aladhan)
# --------------------------------------------------------------------------
def g2j(y, m, d):
    a = (14 - m) // 12
    yy, mm = y + 4800 - a, m + 12 * a - 3
    return d + (153 * mm + 2) // 5 + 365 * yy + yy // 4 - yy // 100 + yy // 400 - 32045


def j2g(jdn):
    j = jdn + 32044
    g = (4 * j + 3) // 146097
    c = j - (146097 * g) // 4
    dp = (4 * c + 3) // 1461
    e = c - (1461 * dp) // 4
    mm = (5 * e + 2) // 153
    return (100 * g + dp - 4800 + mm // 10, mm + 3 - 12 * (mm // 10),
            e - (153 * mm + 2) // 5 + 1)


def j2jul(jdn):
    """JDN -> Julian (y, m, d). Amazigh year = Julian year + 950."""
    c = jdn + 32082
    d = (4 * c + 3) // 1461
    e = c - (1461 * d) // 4
    mm = (5 * e + 2) // 153
    return (d - 4800 + mm // 10, mm + 3 - 12 * (mm // 10),
            e - (153 * mm + 2) // 5 + 1)


def jul2j(y, m, d):
    a = (14 - m) // 12
    yy, mm = y + 4800 - a, m + 12 * a - 3
    return d + (153 * mm + 2) // 5 + 365 * yy + yy // 4 - 32083


def j2hij(jdn):
    """JDN -> Hijri (y, m, d) via the vendored Umm al-Qura table."""
    rjd = jdn - 2400000
    lo, hi = 0, len(MONTH_STARTS) - 1
    while lo + 1 < hi:
        mid = (lo + hi) // 2
        if MONTH_STARTS[mid] <= rjd:
            lo = mid
        else:
            hi = mid
    mi = lo + HIJRI_OFFSET
    return mi // 12 + 1, mi % 12 + 1, rjd - MONTH_STARTS[lo] + 1


def to_cal(jdn, cal):
    if cal == "gregorian":
        return j2g(jdn)
    if cal == "amazigh":
        y, m, d = j2jul(jdn)
        return y + 950, m, d
    return j2hij(jdn)


def month_bounds(cal, y, m):
    """First JDN of the month and its length in days."""
    if cal == "gregorian":
        first = g2j(y, m, 1)
        nxt = g2j(y + 1, 1, 1) if m == 12 else g2j(y, m + 1, 1)
    elif cal == "amazigh":
        jy = y - 950
        first = jul2j(jy, m, 1)
        nxt = jul2j(jy + 1, 1, 1) if m == 12 else jul2j(jy, m + 1, 1)
    else:
        idx = (y - 1) * 12 + m - 1 - HIJRI_OFFSET
        if idx < 0 or idx + 1 >= len(MONTH_STARTS):
            raise IndexError("hijri month out of vendored range")
        first = MONTH_STARTS[idx] + 2400000
        nxt = MONTH_STARTS[idx + 1] + 2400000
    return first, nxt - first


def step(y, m, delta):
    m += delta
    if m > 12:
        y, m = y + 1, 1
    elif m < 1:
        y, m = y - 1, 12
    return y, m


def month_name(cal, m):
    return MONTHS[CALS[cal][0]][m - 1]


# --------------------------------------------------------------------------
# Config
# --------------------------------------------------------------------------
STYLE_PATH = os.path.join(CONFIG_DIR, "style.css")

CONFIG_TEMPLATE = """\
# hypr-calendar
#
# Look & feel. The visual theme itself comes from the system GTK theme
# (~/.config/gtk-4.0/settings.ini -> gtk-theme-name); this widget follows it.
#
# To change *this widget's* colours, sizes or fonts, write CSS into
#   ~/.config/hypr-calendar/style.css
# which is loaded after our stylesheet, so anything there wins. Example:
#
#   .day            { border-radius: 4px; }
#   .day.today      { background-color: #f5c2e7; color: #1e1e2e; }
#   .cal-head       { background-color: #181825; }
#   .info           { font-size: 10px; letter-spacing: 1px; }
#
# calendar: which calendar system to open on.
#   gregorian | hijri | amazigh
"""


def load_config():
    cfg = {"calendar": "gregorian"}
    try:
        for line in open(CONFIG_PATH):
            line = line.strip()
            if "=" in line and not line.startswith("#"):
                k, v = line.split("=", 1)
                if k in cfg:
                    cfg[k] = v.strip()
    except OSError:
        pass
    if cfg["calendar"] not in CALS:
        cfg["calendar"] = "gregorian"
    return cfg


def save_config(cfg):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    # only rewrite when the file is ours, so user comments survive
    try:
        head = open(CONFIG_PATH).read(16)
        own = head.startswith("# hypr-calendar")
    except OSError:
        own = False
    if not own:
        open(CONFIG_PATH, "w").write(CONFIG_TEMPLATE)
    body = open(CONFIG_PATH).read()
    for k in ("calendar",):
        old = [l for l in body.splitlines() if l.startswith(k + "=")]
        if old and old[0] != f"{k}={cfg[k]}":
            body = body.replace(old[0], f"{k}={cfg[k]}")
        elif not old:
            body = body.rstrip("\n") + f"\n{k}={cfg[k]}\n"
    open(CONFIG_PATH, "w").write(body)


def build_css():
    """Structure only; every colour is either a GTK named colour (resolved by
    the active system theme) or an alpha tint of the foreground, so the widget
    tracks light and dark themes without knowing which one is running."""
    return """
