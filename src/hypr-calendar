}
.title-year:hover { background-color: alpha(@theme_selected_bg_color, 0.18); }
/* The switcher runs in three scripts; each button picks the font that has
   real glyphs for its label instead of relying on Pango's fallback. */
.lang-ar { font-family: "Noto Sans Arabic", "Noto Sans", sans-serif; }
.lang-tfng { font-family: "Noto Sans Tifinagh", "Noto Sans", sans-serif; }

/* Controls: keep the theme's own fill, only settle shape and spacing. */
button {
  background-image: none;
  box-shadow: none;
  outline: none;
  border: none;
  text-shadow: none;
  transition: none;
}
.nav {
  min-width: 34px;
  min-height: 34px;
  border-radius: 9px;
