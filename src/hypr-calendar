# --------------------------------------------------------------------------
# UI
# --------------------------------------------------------------------------
class Calendar(Gtk.ApplicationWindow):
    def __init__(self, app, cfg):
        super().__init__(application=app, title="hypr-calendar")
        self.cfg = cfg
        today = datetime.date.today()
        self.today_jdn = g2j(today.year, today.month, today.day)
        self.sel_jdn = self.today_jdn
        y, m, _ = to_cal(self.today_jdn, self.cfg["calendar"])
        self.view = (y, m)
        # Drill-down level of the grid: the year picker, then the month picker,
        # then the default day grid. The title's year button walks up again.
        self.mode = "days"
        self.provider = None

        self.set_default_size(704, 648)

        hb = Gtk.HeaderBar()
        hb.add_css_class("cal-head")
        # No minimize/maximize/close: this is a popup overlay, not a window
        # you manage. Escape or the launcher key toggles it.
        hb.set_show_title_buttons(False)
        self._build_header(hb)
        self.set_titlebar(hb)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        root.add_css_class("root")
        self.set_child(root)

        # A box, not a label: each period is its own row of labels so the
        # Arabic tag can never reorder the digits next to it.
        self.info = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5)
        self.info.add_css_class("info")
        self.info.set_halign(Gtk.Align.CENTER)
        root.append(self.info)

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.NEVER)
        scroll.set_vexpand(True)
        root.append(scroll)

        self.grid = Gtk.Grid()
        self.grid.add_css_class("grid")
        self.grid.set_column_spacing(5)
        self.grid.set_row_spacing(5)
        self.grid.set_margin_top(2)
        self.grid.set_margin_bottom(8)
        self.grid.set_margin_start(8)
        self.grid.set_margin_end(8)
        scroll.set_child(self.grid)

        self.apply_css()
        self.rebuild()

        key = Gtk.EventControllerKey()
        key.connect("key-pressed", self.on_key)
        self.add_controller(key)

    # ---- header ----
    def _build_header(self, hb):
        self.prev_btn = Gtk.Button(label="‹")
        self.prev_btn.add_css_class("nav")
        self.prev_btn.connect("clicked", lambda *_: self.nav_month(-1))
        hb.pack_start(self.prev_btn)

        self.next_btn = Gtk.Button(label="›")
        self.next_btn.add_css_class("nav")
        self.next_btn.connect("clicked", lambda *_: self.nav_month(1))
        hb.pack_end(self.next_btn)

        self.today_btn = Gtk.Button(label="Today")
        self.today_btn.add_css_class("theme-btn")
        self.today_btn.connect("clicked", lambda *_: self.go_today())
        hb.pack_end(self.today_btn)

        # Title: the month name, then the year as a button. The year is the
        # entry point into the year picker -> month picker -> day grid cycle.
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        box.set_halign(Gtk.Align.CENTER)
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        row.set_halign(Gtk.Align.CENTER)
        self.title_lbl = Gtk.Label()
        self.title_lbl.add_css_class("title")
        self.title_year = Gtk.Button()
        self.title_year.add_css_class("title-year")
        self.title_year.connect("clicked", self.on_title_year)
        row.append(self.title_lbl)
        row.append(self.title_year)
        self.title_sub = Gtk.Label()
        self.title_sub.add_css_class("title-sub")
        box.append(row)
        box.append(self.title_sub)
        hb.set_title_widget(box)

        # Calendar switcher. Grouping/setting-active emits "toggled", so every
        # handler is connected only after all three buttons exist and are in
        # their final state - otherwise a stray signal during construction can
        # call on_cal_toggle and move the view to the wrong month.
        sw = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        sw.add_css_class("cal-switch")
        self.cal_btns = {}
        buttons = []
        for cal in CAL_ORDER:
            label, font_cls = CAL_LABEL[cal]
            b = Gtk.ToggleButton(label=label)
            # Each label is rendered by the font that actually has glyphs for
            # it; "Noto Sans" alone would tofu the Tifinagh one.
            if font_cls:
                b.add_css_class(font_cls)
            if buttons:
                b.set_group(buttons[-1])
            buttons.append(b)
        for cal, b in zip(CAL_ORDER, buttons):
            b.set_active(cal == self.cfg["calendar"])
        for cal, b in zip(CAL_ORDER, buttons):
            b.connect("toggled", self.on_cal_toggle, cal)
            sw.append(b)
            self.cal_btns[cal] = b
        hb.pack_start(sw)

    # ---- theme ----
    def apply_css(self):
        css = build_css()
        # The user's own stylesheet loads last, so it wins over everything
        # above. Missing file is normal - it is optional.
        try:
            css += "\n" + open(STYLE_PATH).read()
        except OSError:
            pass
        if self.provider is None:
            self.provider = Gtk.CssProvider()
            # Above USER (800) on purpose: nothing in GTK's own scale is higher,
            # but keeping the value free-form means a system gtk.css at 800 can
            # never quietly win a tie against this widget's own rules.
            Gtk.StyleContext.add_provider_for_display(
                self.get_display(), self.provider, 900)
        self.provider.load_from_data(css.encode("utf-8"))

    def on_cal_toggle(self, btn, cal):
        if not btn.get_active():
            return
        if self.cfg["calendar"] == cal:
            return
        self.cfg["calendar"] = cal
        save_config(self.cfg)
        # keep the cursor on the same point in time across calendars
        self.view = to_cal(self.sel_jdn, cal)[:2]
        self.rebuild()

    # ---- navigation ----
    def nav_month(self, delta):
        """‹ › move one unit of whatever is on screen: a month on the day
        grid, a year on the month grid, a whole page of years on the year
        grid - a page is the unit there, because the picker shows one page
        at a time and a single-year step would double back over it."""
        y, m = self.view
        if self.mode == "days":
            self.view = step(y, m, delta)
        elif self.mode == "years":
            self.view = (y + delta * YEARS_PER_PAGE, m)
        else:
            self.view = (y + delta, m)
        self.rebuild()

    def _year_step(self):
        """How far ↑ ↓ move the year: one year, unless the year picker is up
        and the page is what is actually on screen."""
        return YEARS_PER_PAGE if self.mode == "years" else 1

    def go_today(self):
        self.sel_jdn = self.today_jdn
        self.view = to_cal(self.today_jdn, self.cfg["calendar"])[:2]
        self.mode = "days"
        self.rebuild()

    def on_key(self, _ctrl, keyval, _code, state):
        cal = self.cfg["calendar"]
        if keyval == Gdk.KEY_Escape:
            # Climb the picker first, close only from the day grid.
            if self.mode == "months":
                self.mode = "years"; self.rebuild(); return True
            if self.mode == "years":
                self.mode = "days"; self.rebuild(); return True
            self.close()
            return True
        if keyval in (Gdk.KEY_Left, Gdk.KEY_h):
            self.nav_month(-1); return True
        if keyval in (Gdk.KEY_Right, Gdk.KEY_l):
            self.nav_month(1); return True
        if keyval in (Gdk.KEY_Up, Gdk.KEY_k):
            self.view = (self.view[0] + self._year_step(), self.view[1])
            self.rebuild(); return True
        if keyval in (Gdk.KEY_Down, Gdk.KEY_j):
            self.view = (self.view[0] - self._year_step(), self.view[1])
            self.rebuild(); return True
        if keyval in (Gdk.KEY_t, Gdk.KEY_Home):
            self.go_today(); return True
        if keyval in (Gdk.KEY_1, Gdk.KEY_2, Gdk.KEY_3):
            target = CAL_ORDER[keyval - Gdk.KEY_1]
            if target != cal:
                self.cal_btns[target].set_active(True)
            return True
        return False

    # ---- build ----
    def _clear(self, widget):
        for child in list(widget):
            widget.remove(child)

    # ---- picker construction ----
    def _pair_box(self, tag, text, gap=4, cls=None):
        """One "tag number" unit as *two* labels.

        Keeping the tag in its own label is what makes the bidi safe: an
        Arabic tag can never swallow the digits that follow it, because they
        are not in the same text run. It is also what gives the requested
        breathing room between the letter and the day number.

        No `ellipsize`, deliberately. GTK4 labels *latch*: a label that is
        once laid out in a slot narrower than its text measures its natural
        width from then on as the ellipsised width (November: 65px as built,
        55px after one narrow allocation) and never grows back, even once the
        window is wider than it needs. A window always maps once before it
        has its real size, so every corner month name latched and stayed as
        "G Novemb..." in a cell with 49px going spare. Full text, sized
        honestly, wins: the cell grows to fit instead."""
        b = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=gap)
        t = Gtk.Label(label=tag)
        t.add_css_class("tag")
        b.append(t)
        n = Gtk.Label(label=text)
        if cls:
            n.add_css_class(cls)
        b.append(n)
        return b

    def _corner_boxes(self, cells):
        """Pin one unit to each bottom corner of a Gtk.Overlay.

        `cells` maps calendar key -> widget (built by `_pair_box`). Amazigh
        always sits bottom-left, Hijri always bottom-right, Gregorian fills
        whichever corner is free, so a system keeps the same corner no matter
        which one you are browsing. Shared by the day, month and year cells:
        three copies of this rule is how they drifted apart in the first
        place."""
        left_cal = "amazigh" if "amazigh" in cells else "gregorian"
        right_cal = next(c for c in cells if c != left_cal)

        corners = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=2)
        corners.add_css_class("sec")
        corners.set_halign(Gtk.Align.FILL)
        corners.set_valign(Gtk.Align.END)
        corners.set_margin_start(4)
        corners.set_margin_end(4)
        corners.set_margin_bottom(5)

        left = cells[left_cal]
        left.set_halign(Gtk.Align.START)
        left.set_hexpand(True)          # pushes the right pair outward
        right = cells[right_cal]
        right.set_halign(Gtk.Align.END)
        corners.append(left)
        corners.append(right)
        return corners

    def _build_title(self, cal, y, m):
        # Drop the script class first: it belongs to the days view only, and
        # the year-only titles below must not inherit an Arabic/Tifinagh font.
        for cls in ("lang-ar", "lang-tfng"):
            self.title_lbl.remove_css_class(cls)
        if self.mode == "years":
            # No year button while the years themselves are on screen.
            start = y - YEAR_LEAD
            self.title_lbl.set_text(
                f"{start} – {start + YEARS_PER_PAGE - 1}")
            self.title_year.set_visible(False)
            self.title_sub.set_text("")
            return
        self.title_year.set_visible(True)
        self.title_year.set_label(str(y))
        if self.mode == "months":
            # The bare year is the whole title; it reads as the button it is.
            self.title_lbl.set_text("")
            self.title_sub.set_text("")
            return
        nm = month_name(cal, m)
        # The month is named in the script of the system it belongs to, the
        # rule the month picker cells already follow (month_native), so title
        # and cell can never disagree: October in Latin, ربيع الآخر in Arabic,
        # ⵜⴰⵎⵓⵣ in Tifinagh.
        self.title_lbl.set_text(month_native(cal, m))
        font_cls = CAL_LABEL[cal][1]        # "lang-ar" / "lang-tfng" / ""
        if font_cls:
            # Named font rather than Pango's own fallback: the same choice the
            # switcher makes for its buttons, so the title matches them.
            self.title_lbl.add_css_class(font_cls)
        # Second line is the same month in another script - Tifinagh unless
        # the title is already Tifinagh, which would print it twice.
        self.title_sub.set_text(
            nm["latin"] if NATIVE[cal] == "tifinagh" else nm["tifinagh"])

    def _build_info(self):
        """Today in all three systems. Split into labels for the same bidi
        reason as the day cells, plus a real gap after each period tag.

        Each system is written in its own script - October in Latin, ربيع
        الآخر in Arabic, ⵣ Cutanbir in Tifinagh - so the strip follows the
        same rule as the title and the month cells. Day, month and year are
        three labels rather than one string for that reason too: an Arabic
        run holding Western digits lets Pango flip the paragraph and print
        "4 1447 ربيع الآخر" in the order it pleases."""
        self._clear(self.info)
        self.info.append(Gtk.Label(label="Today"))
        for i, c in enumerate(CAL_ORDER):
            sep = Gtk.Label(label="·")
            sep.add_css_class("sep")
            self.info.append(sep)
            cy, cm, cd = to_cal(self.today_jdn, c)
            unit = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
            tag = Gtk.Label(label=CALS[c][1])
            tag.add_css_class("tag")
            unit.append(tag)
            unit.append(Gtk.Label(label=str(cd)))
            mn = Gtk.Label(label=month_native(c, cm))
            font_cls = CAL_LABEL[c][1]
            if font_cls:
                mn.add_css_class(font_cls)
            unit.append(mn)
            unit.append(Gtk.Label(label=str(cy)))
            self.info.append(unit)

    def _build_days(self, cal, y, m):
        # weekday header row
        for i, w in enumerate(WEEKDAYS):
            lbl = Gtk.Label(label=w)
            lbl.add_css_class("wd")
            if i >= 5:
                lbl.add_css_class("we")
            self.grid.attach(lbl, i + 1, 0, 1, 1)

        try:
            first, length = month_bounds(cal, y, m)
        except (IndexError, OverflowError):
            lbl = Gtk.Label(label="Hijri date outside vendored range (1343-1500)")
            self.grid.attach(lbl, 1, 1, 7, 1)
            return

        others = [c for c in CAL_ORDER if c != cal]
        start = first - (first % 7)          # Monday-aligned
        for i in range(42):
            jdn = start + i
            col, row = (i % 7) + 1, (i // 7) + 1

            if col == 1:                      # ISO week number of that row
                wk = datetime.date(*j2g(jdn)).isocalendar()[1]
                wl = Gtk.Label(label=str(wk))
                wl.add_css_class("wk")
                self.grid.attach(wl, 0, row, 1, 1)

            cy, cm, cd = to_cal(jdn, cal)
            in_month = (cy, cm) == (y, m)

            btn = Gtk.Button()
            btn.add_css_class("day")
            if not in_month:
                btn.add_css_class("other")
            if (i % 7) >= 5:
                btn.add_css_class("we")
            if jdn == self.today_jdn:
                btn.add_css_class("today")
            if jdn == self.sel_jdn:
                btn.add_css_class("sel")

            # Gtk.Overlay rather than a vertical box: the day number must be
            # centred in the whole cell, not in the space left over above the
            # corner row. The box would push it up; the overlay pins the
            # corner row to the bottom and leaves the number free to centre.
            ov = Gtk.Overlay()
            num = Gtk.Label(label=str(cd))
            num.add_css_class("num")
            num.set_halign(Gtk.Align.CENTER)
            num.set_valign(Gtk.Align.CENTER)
            ov.set_child(num)

            # Which corner each system takes is decided in _corner_boxes; the
            # cell itself is built exactly like a day cell - same overlay,
            # same corner row, no sizing of its own.
            cells = {oc: self._pair_box(CALS[oc][1], str(to_cal(jdn, oc)[2]))
                     for oc in others}
            ov.add_overlay(self._corner_boxes(cells))

            btn.set_child(ov)
            btn.connect("clicked", self.on_pick, jdn)
            self.grid.attach(btn, col, row, 1, 1)

    def _months_at(self, cal, y, m):
        """(calendar key, month name in that system's own script) for the
        other two systems at the middle of calendar month y/m.

        The midpoint, not the first day: a Gregorian January spans two Hijri
        months, and the one holding most of it is the useful answer. This is
        the same idea _years_at uses for years."""
        try:
            first, length = month_bounds(cal, y, m)
            jdn = first + length // 2
        except (IndexError, OverflowError, ValueError):
            return []
        return [(oc, month_native(oc, to_cal(jdn, oc)[1]))
                for oc in CAL_ORDER if oc != cal]

    def _build_months(self, cal, y, m):
        ty, tm, _ = to_cal(self.today_jdn, cal)
        for i in range(12):
            mm = i + 1
            btn = Gtk.Button()
            btn.add_css_class("day")
            btn.add_css_class("pick")
            btn.add_css_class("month")
            if (ty, tm) == (y, mm):
                btn.add_css_class("today")
            if mm == m:
                btn.add_css_class("sel")

            # Same shape as a day cell: the month in its own script centred in
            # the whole cell, the other two systems split the bottom row.
            # Latin January, Arabic مُحرَّم, Tifinagh ⵉⵏⵏⴰⵢⵔ -- a month is
            # read in the script of its own system, not transliterated.
            ov = Gtk.Overlay()
            num = Gtk.Label(label=month_native(cal, mm))
            num.add_css_class("num")
            num.set_halign(Gtk.Align.CENTER)
            num.set_valign(Gtk.Align.CENTER)
            ov.set_child(num)

            cells = {oc: self._pair_box(CALS[oc][1], name)
                     for oc, name in self._months_at(cal, y, mm)}
            if cells:
                ov.add_overlay(self._corner_boxes(cells))

            btn.set_child(ov)
            btn.connect("clicked", self.on_pick_month, mm)
            self.grid.attach(btn, i % 4, i // 4, 1, 1)

    def _years_at(self, cal, y):
        """(calendar key, year) for the other systems at the middle of
        calendar year y -- the midpoint, because a Hijri year straddles two
        Gregorian ones and the middle says which is which."""
        try:
            if cal == "gregorian":
                jdn = g2j(y, 7, 1)
            elif cal == "amazigh":
                jdn = jul2j(y - 950, 7, 1)
            else:
                first, length = month_bounds(cal, y, 6)
                jdn = first + length // 2
        except (IndexError, OverflowError, ValueError):
            return []
        return [(oc, str(to_cal(jdn, oc)[0]))
                for oc in CAL_ORDER if oc != cal]

    def _build_years(self, cal, y):
        start = y - YEAR_LEAD
        today_y = to_cal(self.today_jdn, cal)[0]
        for i in range(YEARS_PER_PAGE):
            yy = start + i
            btn = Gtk.Button()
            btn.add_css_class("day")
            btn.add_css_class("pick")
            btn.add_css_class("year")
            if yy == today_y:
                btn.add_css_class("today")
            if yy == y:
                btn.add_css_class("sel")

            # Identical shape to the day and month cells: the year centred,
            # the other two systems split the bottom corners.
            ov = Gtk.Overlay()
            num = Gtk.Label(label=str(yy))
            num.add_css_class("num")
            num.set_halign(Gtk.Align.CENTER)
            num.set_valign(Gtk.Align.CENTER)
            ov.set_child(num)

            cells = {oc: self._pair_box(CALS[oc][1], other_y)
                     for oc, other_y in self._years_at(cal, yy)}
            if cells:
                ov.add_overlay(self._corner_boxes(cells))

            btn.set_child(ov)
            btn.connect("clicked", self.on_pick_year, yy)
            self.grid.attach(btn, i % 4, i // 4, 1, 1)

    def rebuild(self):
        cal = self.cfg["calendar"]
        y, m = self.view
        self._clear(self.grid)

        # The pickers are four across and centred as a block; the day grid
        # keeps its natural seven-plus-week-column sizing and fills the width.
        # Rows are deliberately NOT homogeneous and the grid does not stretch
        # vertically: homogeneous rows would soak up the whole viewport and
        # turn three rows of months into 300px slabs.
        pick = self.mode != "days"
        self.grid.set_column_homogeneous(pick)
        self.grid.set_row_homogeneous(False)
        self.grid.set_halign(Gtk.Align.CENTER if pick else Gtk.Align.FILL)
        self.grid.set_valign(Gtk.Align.CENTER if pick else Gtk.Align.FILL)

        self._build_title(cal, y, m)
        self._build_info()

        if self.mode == "years":
            self._build_years(cal, y)
        elif self.mode == "months":
            self._build_months(cal, y, m)
        else:
            self._build_days(cal, y, m)

    # ---- picker selection ----
    def on_title_year(self, *_):
        """Clicking the year in the title swaps the day grid for the years."""
        if self.mode in ("days", "months"):
            self.mode = "years"
            self.rebuild()

    def on_pick_year(self, _btn, yy):
        """Picking a year drills down to that year's months."""
        self.view = (yy, self.view[1])
        self.mode = "months"
        self.rebuild()

    def on_pick_month(self, _btn, mm):
        """Picking a month returns to the default day grid."""
        self.view = (self.view[0], mm)
        self.mode = "days"
        self.rebuild()

    def on_pick(self, _btn, jdn):
        self.sel_jdn = jdn
        self.rebuild()


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="app.omniversify.hyprcalendar")

    def do_activate(self):
        win = self.props.active_window
        if win is None:
            win = Calendar(self, load_config())
        win.present()


if __name__ == "__main__":
    sys.exit(App().run([]))
